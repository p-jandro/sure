<% content_for :page_title, t("finance_workspace.preview.title") %>
<% content_for :page_actions do %>
  <%= render DS::Link.new(text: t("finance_workspace.preview.back"), href: finance_workspace_path(entity: @metadata[:entity]), variant: :ghost, icon: "arrow-left") %>
<% end %>

<div class="space-y-6" data-testid="bank-file-preview">
  <%= render DS::Card.new do %>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="space-y-2 min-w-0">
        <h2 class="font-medium text-primary break-words"><%= @metadata[:filename] %></h2>
        <p class="text-sm text-secondary"><%= @metadata[:owner_name] %> · <%= t("finance_workspace.entities.#{@metadata[:entity]}") %></p>
        <p class="text-xs text-secondary"><%= @preview[:bank].to_s.humanize %> · <%= t("finance_workspace.preview.formats.#{@preview[:format]}", default: @preview[:format].to_s.humanize) %></p>
      </div>
      <%= render DS::Pill.new(label: t(@bank_import.complete? ? "finance_workspace.statuses.complete" : "finance_workspace.preview.ready"), tone: @bank_import.complete? ? :success : :info, marker: false) %>
    </div>
    <dl class="grid gap-4 sm:grid-cols-2 mt-5">
      <%= render DS::DetailRow.new(label: t("finance_workspace.preview.source_rows"), value: number_with_delimiter(@preview[:row_count])) %>
      <%= render DS::DetailRow.new(label: t("finance_workspace.preview.movements"), value: number_with_delimiter(@preview[:transaction_count])) %>
      <%= render DS::DetailRow.new(label: t("finance_workspace.preview.skipped"), value: number_with_delimiter(@preview[:skipped_count])) %>
      <%= render DS::DetailRow.new(label: t("finance_workspace.preview.review"), value: number_with_delimiter(@preview[:review_count])) %>
      <% if @preview[:date_from].present? && @preview[:date_to].present? %>
        <%= render DS::DetailRow.new(label: t("finance_workspace.preview.from"), value: l(@preview[:date_from].to_date, format: :long)) %>
        <%= render DS::DetailRow.new(label: t("finance_workspace.preview.to"), value: l(@preview[:date_to].to_date, format: :long)) %>
      <% end %>
    </dl>
  <% end %>

  <%= render DS::Alert.new(message: t("finance_workspace.preview.idempotency"), variant: :info) %>
  <% Array(@preview[:warnings]).each do |warning| %>
    <%= render DS::Alert.new(message: warning, variant: :warning) %>
  <% end %>

  <section class="space-y-3" aria-labelledby="preview-totals-title">
    <h2 id="preview-totals-title" class="font-medium text-primary"><%= t("finance_workspace.preview.totals") %></h2>
    <p class="text-xs text-secondary"><%= t("finance_workspace.preview.totals_hint") %></p>
    <%= render DS::Table.new(rows: Array(@preview[:totals]), label: t("finance_workspace.preview.totals")) do |table| %>
      <% table.with_column(t("finance_workspace.columns.currency")) { |row| row[:currency] } %>
      <% table.with_column(t("finance_workspace.cashflow.money_in"), numeric: true, class: "privacy-sensitive") { |row| format_money(Money.new(row[:inflow].to_d, row[:currency])) } %>
      <% table.with_column(t("finance_workspace.cashflow.refunds"), numeric: true, class: "privacy-sensitive") { |row| format_money(Money.new((row[:refunds] || 0).to_d, row[:currency])) } %>
      <% table.with_column(t("finance_workspace.cashflow.money_out"), numeric: true, class: "privacy-sensitive") { |row| format_money(Money.new(row[:outflow].to_d, row[:currency])) } %>
      <% table.with_column(t("finance_workspace.preview.fees"), numeric: true, class: "privacy-sensitive") { |row| format_money(Money.new(row[:fees].to_d, row[:currency])) } %>
      <% table.with_column(t("finance_workspace.cashflow.net"), numeric: true, class: "privacy-sensitive") { |row| format_money(Money.new(row[:net].to_d, row[:currency])) } %>
    <% end %>
  </section>

  <section class="space-y-3" aria-labelledby="preview-sample-title">
    <h2 id="preview-sample-title" class="font-medium text-primary"><%= t("finance_workspace.preview.sample") %></h2>
    <%= render DS::Table.new(rows: Array(@preview[:sample_rows]), label: t("finance_workspace.preview.sample")) do |table| %>
      <% table.with_column(t("finance_workspace.columns.date")) { |row| l(row[:date].to_date, format: :long) } %>
      <% table.with_column(t("finance_workspace.columns.description")) { |row| row[:name] } %>
      <% table.with_column(t("finance_workspace.columns.type")) { |row| t("finance_workspace.preview.kinds.#{row[:kind]}", default: row[:kind].to_s.humanize) } %>
      <% table.with_column(t("finance_workspace.columns.amount"), numeric: true, class: "privacy-sensitive") { |row| format_money(Money.new(-row[:amount].to_d, row[:currency])) } %>
    <% end %>
  </section>

  <% if @bank_import.pending? %>
    <%= render DS::Alert.new(message: t("finance_workspace.preview.balance_notice"), variant: :warning) %>
    <div class="flex flex-wrap justify-end gap-2">
      <%= render DS::Button.new(text: t("finance_workspace.preview.discard"), href: finance_workspace_import_path(@bank_import), method: :delete, variant: :secondary) %>
      <%= render DS::Button.new(text: t("finance_workspace.preview.confirm"), href: confirm_finance_workspace_import_path(@bank_import), method: :post, variant: :primary, icon: "check") %>
    </div>
  <% end %>
</div>
